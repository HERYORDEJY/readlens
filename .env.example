# Copy to .env and fill in. .env is gitignored.

# Base URL of the Readlens development API.
READLENS_API_BASE_URL=https://dev.api.readlens.app/api/v1

# HTTP Basic Auth credentials supplied with the assessment brief.
# Every request to the API — and to dev.readlens.app — must carry these.
READLENS_BASIC_AUTH_USERNAME=
READLENS_BASIC_AUTH_PASSWORD=
